{
  "name": "presenter",
  "version": "1.0.0",
  "description": "Presenter — Modern Church Scripture & Song Presentation System with OBS & NDI integration",
  "author": "Thruqe <danielpeter0039@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Thruqe/Presenter.git"
  },
  "homepage": "https://github.com/Thruqe/Presenter#readme",
  "bugs": {
    "url": "https://github.com/Thruqe/Presenter/issues"
  },
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "generate:icons": "bun run scripts/generate-icons.ts",
    "stamp:metadata": "bun run scripts/stamp-windows-metadata.ts",
    "build:server:linux": "bun build --compile --minify --sourcemap --target=bun-linux-x64 ./src/index.ts --outfile dist/presenter-server-linux-x64",
    "build:server:linux-arm64": "bun build --compile --minify --sourcemap --target=bun-linux-arm64 ./src/index.ts --outfile dist/presenter-server-linux-arm64",
    "build:server:linux-musl": "bun build --compile --minify --sourcemap --target=bun-linux-x64-musl ./src/index.ts --outfile dist/presenter-server-linux-x64-musl",
    "build:server:macos": "bun build --compile --minify --sourcemap --target=bun-darwin-x64 ./src/index.ts --outfile dist/presenter-server-macos-x64",
    "build:server:macos-arm64": "bun build --compile --minify --sourcemap --target=bun-darwin-arm64 ./src/index.ts --outfile dist/presenter-server-macos-arm64",
    "build:server:windows": "bun build --compile --minify --sourcemap --target=bun-windows-x64 ./src/index.ts --outfile dist/presenter-server-windows-x64.exe",
    "build:server:all": "bun run build:server:linux && bun run build:server:linux-arm64 && bun run build:server:linux-musl && bun run build:server:macos && bun run build:server:macos-arm64 && bun run build:server:windows",
    "build:gui:linux": "bun build --compile --minify --sourcemap --target=bun-linux-x64 ./src/gui.ts ./src/index.ts --outfile dist/presenter-gui-linux-x64",
    "build:gui:linux-arm64": "bun build --compile --minify --sourcemap --target=bun-linux-arm64 ./src/gui.ts ./src/index.ts --outfile dist/presenter-gui-linux-arm64",
    "build:gui:macos": "bun build --compile --minify --sourcemap --target=bun-darwin-x64 ./src/gui.ts ./src/index.ts --outfile dist/presenter-gui-macos-x64",
    "build:gui:macos-arm64": "bun build --compile --minify --sourcemap --target=bun-darwin-arm64 ./src/gui.ts ./src/index.ts --outfile dist/presenter-gui-macos-arm64",
    "build:gui:windows": "bun build --compile --minify --sourcemap --target=bun-windows-x64 --windows-hide-console ./src/gui.ts ./src/index.ts --outfile dist/presenter-gui-windows-x64.exe",
    "build:assets": "bun run scripts/copy-assets.ts",
    "build:obs-plugin": "bun run scripts/package-obs-plugin.ts",
    "build:windows": "bun run build:server:windows && bun run build:gui:windows && bun run build:assets && bun run build:obs-plugin && bun run stamp:metadata",
    "build:linux": "bun run build:server:linux && bun run build:gui:linux && bun run build:assets && bun run build:obs-plugin",
    "build:all": "bun run build:server:all && bun run build:gui:all && bun run build:assets && bun run build:obs-plugin"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "png-to-ico": "^3.0.2",
    "rcedit": "^5.0.2"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@napi-rs/image": "^1.14.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "webview-bun": "^2.4.0"
  }
}